// Tang Nano 9K pinout (GW1NR-LV9QN88PC6/I5), from Sipeed's TangNano-9K-example (lcd_led, uart).

IO_LOC "XTAL_IN" 52;
IO_PORT "XTAL_IN" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "BTN_RESET" 4;
IO_PORT "BTN_RESET" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC "BTN_USER" 3;
IO_PORT "BTN_USER" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC "UART_RX" 18;
IO_PORT "UART_RX" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "UART_TX" 17;
IO_PORT "UART_TX" IO_TYPE=LVCMOS33;

IO_LOC "LED_N[0]" 10;
