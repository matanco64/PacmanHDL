// Tang Nano 20K pinout (GW2AR-LV18QN88C8/I7), from Sipeed's TangNano-20K-example
// (rgb_lcd/lcd_800_400, uart, led). The 20K's LCD connector has no HSYNC/VSYNC
// (the panel runs in DE mode); they go to spare pins 25/26 and can be ignored.

IO_LOC "XTAL_IN" 4;
IO_PORT "XTAL_IN" IO_TYPE=LVCMOS33;
IO_LOC "BTN_RESET" 88;
IO_PORT "BTN_RESET" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "BTN_USER" 87;
IO_PORT "BTN_USER" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "UART_RX" 70;
IO_PORT "UART_RX" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "UART_TX" 69;
IO_PORT "UART_TX" IO_TYPE=LVCMOS33;
IO_LOC "LCD_CLK" 77;
IO_PORT "LCD_CLK" IO_TYPE=LVCMOS33;
IO_LOC "LCD_DEN" 48;
IO_PORT "LCD_DEN" IO_TYPE=LVCMOS33;
IO_LOC "LCD_HSYNC" 25;
IO_PORT "LCD_HSYNC" IO_TYPE=LVCMOS33;
IO_LOC "LCD_VSYNC" 26;
IO_PORT "LCD_VSYNC" IO_TYPE=LVCMOS33;
IO_LOC "LCD_R[0]" 42;
IO_PORT "LCD_R[0]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_R[1]" 41;
IO_PORT "LCD_R[1]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_R[2]" 40;
IO_PORT "LCD_R[2]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_R[3]" 39;
IO_PORT "LCD_R[3]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_R[4]" 38;
IO_PORT "LCD_R[4]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_G[0]" 37;
IO_PORT "LCD_G[0]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_G[1]" 36;
IO_PORT "LCD_G[1]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_G[2]" 35;
IO_PORT "LCD_G[2]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_G[3]" 34;
IO_PORT "LCD_G[3]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_G[4]" 33;
IO_PORT "LCD_G[4]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_G[5]" 32;
IO_PORT "LCD_G[5]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_B[0]" 31;
IO_PORT "LCD_B[0]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_B[1]" 30;
IO_PORT "LCD_B[1]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_B[2]" 29;
IO_PORT "LCD_B[2]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_B[3]" 28;
IO_PORT "LCD_B[3]" IO_TYPE=LVCMOS33;
IO_LOC "LCD_B[4]" 27;
IO_PORT "LCD_B[4]" IO_TYPE=LVCMOS33;
IO_LOC "LED_N[0]" 15;
IO_PORT "LED_N[0]" IO_TYPE=LVCMOS33;
IO_LOC "LED_N[1]" 16;
IO_PORT "LED_N[1]" IO_TYPE=LVCMOS33;
IO_LOC "LED_N[2]" 17;
IO_PORT "LED_N[2]" IO_TYPE=LVCMOS33;
IO_LOC "LED_N[3]" 18;
IO_PORT "LED_N[3]" IO_TYPE=LVCMOS33;
IO_LOC "LED_N[4]" 19;
IO_PORT "LED_N[4]" IO_TYPE=LVCMOS33;
IO_LOC "LED_N[5]" 20;
IO_PORT "LED_N[5]" IO_TYPE=LVCMOS33;
